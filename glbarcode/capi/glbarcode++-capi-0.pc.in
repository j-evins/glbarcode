prefix=@CMAKE_INSTALL_PREFIX@
libdir=@CMAKE_INSTALL_PREFIX@/lib
includedir=@CMAKE_INSTALL_PREFIX@/include

Name: @Unique_CAPI_Package_Name@
Description: C API to glbarcode++ Barcode Generator Library
Version: @Package_Version@
Libs: -L${libdir} -lglbarcode-capi
Cflags: -I${includedir}
Requires: @Unique_Package_Name@
